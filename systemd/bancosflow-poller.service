[Unit]
Description=BancosFlow - poller de la carpeta del dia
Documentation=https://github.com/Zara-Zugarramurdi/BancosFlow
# El proceso necesita el share montado; si es un montaje de systemd, descomentar
# y ajustar el nombre de la unidad correspondiente:
# Requires=media-windowsshare.mount
# After=media-windowsshare.mount
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/teledata/BancosFlow
Environment=NODE_ENV=production
Environment=BANCOSFLOW_CONFIG=/home/teledata/BancosFlow/config/bancosflow.config.json
ExecStart=/usr/bin/node /home/teledata/BancosFlow/dist/poller.js

# Si el proceso muere por cualquier motivo, systemd lo vuelve a levantar.
Restart=always
RestartSec=30

# PrivateTmp NO se usa a proposito: el modo --dry-run del orquestador copia la
# planilla a un temporal, y con PrivateTmp ese temporal queda en un /tmp aislado
# distinto al del resto del sistema, lo que complica inspeccionarlo al depurar.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
